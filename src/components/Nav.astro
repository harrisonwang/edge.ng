---
const navItems = [
    { href: "#features", label: "特性" },
    { href: "#quickstart", label: "快速开始" },
    { href: "#selfhost", label: "自建部署" },
];
---

<header>
    <div class="wrap bar">
        <a href="#top" class="brand">
            <svg width="18" height="18" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                <path d="M4 6l10 10L4 26" stroke="var(--terracotta)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M17 6l10 10L17 26" stroke="#dfa285" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="name">edge.ng</span>
        </a>
        <nav class="links">
            {navItems.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
    </div>
</header>

<style>
    header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(250, 248, 243, 0.82);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
    }
    .bar {
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }
    .brand {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .name {
        font-family: var(--display);
        font-weight: 700;
        font-size: 19px;
    }
    .links {
        display: flex;
        align-items: center;
        gap: 30px;
        font-size: 14px;
        font-weight: 500;
        color: var(--ink-2);
        white-space: nowrap;
    }
    .links a:hover {
        color: var(--terracotta);
    }
    @media (max-width: 640px) {
        .links {
            gap: 18px;
            font-size: 13px;
        }
    }
</style>
