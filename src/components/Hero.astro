---
const CMD = "ssh -R dev:80:127.0.0.1:8080 ssh.edge.ng";
---

<section id="top">
    <div class="wrap grid">
        <div class="col">
            <div class="badge"><span class="dot"></span>基于 SSH 隧道的内网穿透服务</div>
            <h1><span class="hl">一条命令</span><br />将本地服务暴露到公网</h1>
            <p class="sub">
                通过 SSH 反向隧道将本地服务暴露到公网。无需安装客户端，无需注册账号，支持自定义子域名，自动
                HTTPS。
            </p>
            <div class="cta">
                <a class="primary" href="#quickstart">快速开始 <span>→</span></a>
                <a class="ghlink" href="#features">了解特性<span>→</span></a>
            </div>
        </div>
        <div class="col">
            <div class="term" aria-label="终端演示">
                <div class="term-bar">
                    <span class="dots"><i></i><i></i><i></i></span>
                    <span class="title">ssh — edge.ng</span>
                    <button class="copy" data-copy={CMD} aria-label="复制命令">&#8943;</button>
                </div>
                <div class="term-body">
                    <div class="cl"><span class="dollar">$ </span><span class="cmd">{CMD}</span></div>
                    <div class="cl">&nbsp;</div>
                    <div class="cl dim">Press Ctrl-C to close the session.</div>
                    <div class="cl">&nbsp;</div>
                    <div class="cl norm">Starting SSH Forwarding service for http:80.</div>
                    <div class="cl norm">Forwarded connections can be accessed via the following methods:</div>
                    <div class="cl"><span class="proto">HTTP</span><span class="norm">: </span><span class="uri">http://dev.edge.ng</span></div>
                    <div class="cl"><span class="proto">HTTPS</span><span class="norm">: </span><span class="uri">https://dev.edge.ng</span><span class="cursor"></span></div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((b) => {
        b.addEventListener("click", () => {
            navigator.clipboard?.writeText(b.dataset.copy || "");
            const prev = b.textContent;
            b.textContent = "✓";
            setTimeout(() => {
                b.textContent = prev;
            }, 1400);
        });
    });
</script>

<style>
    .grid {
        padding: 78px 32px 72px;
        display: grid;
        grid-template-columns: minmax(360px, 0.94fr) minmax(480px, 1.06fr);
        gap: 56px;
        align-items: center;
    }
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: #f6ece4;
        border: 1px solid #ecd9c9;
        color: var(--terracotta-dark);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.04em;
        padding: 6px 13px;
        border-radius: 999px;
        font-family: var(--mono);
    }
    .badge .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--terracotta);
    }
    h1 {
        font-weight: 700;
        font-size: clamp(34px, 3.9vw, 52px);
        line-height: 1.12;
        letter-spacing: -0.028em;
        margin: 22px 0 0;
        text-wrap: balance;
    }
    .hl {
        color: var(--terracotta);
    }
    .sub {
        font-size: clamp(16px, 1.5vw, 18px);
        line-height: 1.7;
        color: var(--ink-2);
        margin: 20px 0 0;
        max-width: 520px;
    }
    .cta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 20px;
        margin: 30px 0 0;
    }
    .primary {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 12px 20px;
        color: #fffaf5;
        background: var(--terracotta);
        border-radius: 10px;
        box-shadow: 0 10px 22px rgba(178, 91, 52, 0.18);
        font-size: 14.5px;
        font-weight: 700;
        transition:
            transform 0.18s ease,
            box-shadow 0.18s ease,
            background 0.18s ease;
    }
    .primary:hover {
        background: var(--terracotta-dark);
        box-shadow: 0 14px 26px rgba(178, 91, 52, 0.25);
        transform: translateY(-2px);
    }
    .primary span {
        transition: transform 0.15s ease;
    }
    .primary:hover span {
        transform: translateX(2px);
    }
    .ghlink {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 14px;
        font-weight: 600;
        color: var(--ink);
        border-bottom: 2px solid #e7c9b8;
        padding-bottom: 2px;
        transition: border-color 0.15s;
    }
    .ghlink:hover {
        border-color: var(--terracotta);
    }

    /* ---- Terminal window ---- */
    .term {
        background: var(--term-bg);
        border: 1px solid #2c2924;
        border-radius: 14px;
        box-shadow:
            inset 0 1px rgba(255, 255, 255, 0.04),
            0 24px 60px rgba(67, 45, 24, 0.16);
        overflow: hidden;
    }
    .term-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 14px;
        background: var(--term-bg-2);
        border-bottom: 1px solid var(--term-line);
    }
    .dots {
        display: inline-flex;
        gap: 6px;
    }
    .dots i {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: block;
    }
    .dots i:nth-child(1) {
        background: #665b4d;
    }
    .dots i:nth-child(2) {
        background: #514c43;
    }
    .dots i:nth-child(3) {
        background: #3e4e37;
    }
    .title {
        flex: 1;
        text-align: center;
        font-family: var(--mono);
        font-size: 11px;
        color: #7c7567;
    }
    .copy {
        width: 30px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: #2b2823;
        color: #cabfae;
        border-radius: 7px;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.15s;
    }
    .copy:hover {
        background: #3a352d;
    }
    .term-body {
        padding: 20px 20px 24px;
        font-family: var(--mono);
        font-size: 12.5px;
        line-height: 1.85;
    }
    .cl {
        white-space: pre-wrap;
        word-break: break-all;
    }
    .dollar {
        color: #7fae6a;
    }
    .cmd {
        color: #f4f0e6;
        font-weight: 500;
    }
    .dim {
        color: #8b8472;
    }
    .norm {
        color: #d8d4ca;
    }
    .proto {
        color: #9db98a;
        font-weight: 600;
    }
    .uri {
        color: #eaa074;
    }
    .cursor {
        display: inline-block;
        width: 7px;
        height: 14px;
        margin-left: 6px;
        vertical-align: -2px;
        background: #d8d4ca;
        animation: blink 1.1s steps(1) infinite;
    }
    @media (max-width: 1000px) {
        .grid {
            grid-template-columns: 1fr;
            padding: 56px 24px 56px;
            gap: 40px;
        }
    }
    @media (max-width: 620px) {
        .grid {
            padding: 44px 18px 44px;
        }
        .term-body {
            font-size: 11.5px;
        }
    }
</style>
