---
import "../styles/global.css";
interface Props {
    title?: string;
    description?: string;
}
const {
    title = "edge.ng — SSH 内网穿透 | 一条命令暴露本地服务到公网",
    description = "通过 SSH 反向隧道将本地服务暴露到公网。无需安装客户端，无需注册账号，自定义子域名，自动 HTTPS。",
} = Astro.props;
const pageURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL("/og-localhost.png", Astro.site);
const imageAlt = "edge.ng：localhost，公网见。一条 SSH 命令，把本地项目分享出去。立体橙色隧道连接 localhost:8080 与 dev.edge.ng。免安装、免注册、自动 HTTPS。";
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="description" content={description} />
        <meta name="keywords" content="SSH隧道,内网穿透,端口转发,反向代理,SSH tunnel,自托管" />
        <meta name="generator" content={Astro.generator} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="edge.ng" />
        <meta property="og:locale" content="zh_CN" />
        <meta property="og:url" content={pageURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageURL} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageURL} />
        <meta name="twitter:image:alt" content={imageAlt} />
        <title>{title}</title>
    </head>
    <body>
        <slot />
    </body>
</html>
