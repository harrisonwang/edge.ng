---
import "../styles/global.css";
interface Props {
    title?: string;
    description?: string;
}
const {
    title = "edge.ng — SSH 内网穿透 | 一条命令暴露本地服务到公网",
    description = "通过 SSH 反向隧道将本地服务暴露到公网。无需安装客户端，无需注册账号，自定义子域名，自动 HTTPS。",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="description" content={description} />
        <meta name="keywords" content="SSH隧道,内网穿透,端口转发,反向代理,SSH tunnel,自托管" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <slot />
    </body>
</html>
